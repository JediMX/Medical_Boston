function sincronizarDirectorioAlumnosSheets(forzarSobrescritura) {
  try {
    const ss = (typeof obtenerSpreadsheetPrincipal === 'function') ? obtenerSpreadsheetPrincipal() : SpreadsheetApp.getActiveSpreadsheet();
    let hoja = ss.getSheetByName('Directorio_Alumnos');
    if (!hoja) {
      hoja = ss.insertSheet('Directorio_Alumnos');
    }
    
    const headers = [
      'Nivel',
      'Grupo',
      'Nombre Alumno',
      'Teléfono Mamá / Tutor 1',
      'Nombre Mamá / Tutor 1',
      'Teléfono Papá / Tutor 2',
      'Nombre Papá / Tutor 2'
    ];
    
    const totalFilas = hoja.getLastRow();
    
    // Si la hoja tiene pocas filas o se solicita forzar sobrescritura
    if (totalFilas <= 5 || forzarSobrescritura) {
      hoja.clearContents();
      hoja.getRange(1, 1, 1, headers.length).setValues([headers]);
      hoja.getRange(2, 1, DIRECTORIO_ALUMNOS_OFICIAL.length, headers.length).setValues(DIRECTORIO_ALUMNOS_OFICIAL);
      return { 
        exito: true, 
        total: DIRECTORIO_ALUMNOS_OFICIAL.length, 
        mensaje: 'Se sincronizaron ' + DIRECTORIO_ALUMNOS_OFICIAL.length + ' alumnos en Directorio_Alumnos exitosamente.' 
      };
    }
    
    return { 
      exito: true, 
      total: totalFilas - 1, 
      mensaje: 'El directorio ya cuenta con ' + (totalFilas - 1) + ' alumnos registrados.' 
    };
  } catch (err) {
    return { exito: false, mensaje: 'Error al sincronizar directorio: ' + err.message };
  }
}
